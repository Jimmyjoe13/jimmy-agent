; ─────────────────────────────────────────────────────────────────────────────
; JIMMY — projet Godot (avatar 3D)
; Rôle unique : rendu 3D, animations, expressions, état visuel.
; Il ne contient AUCUNE logique d'agent. Il ne parle qu'à un serveur HTTP local.
; ─────────────────────────────────────────────────────────────────────────────

config_version=5

[application]

config/name="Jimy Avatar"
config/description="Avatar 3D de Jimy, piloté par Tauri via HTTP local."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/show_image=false

[display]

window/size/viewport_width=560
window/size/viewport_height=620
window/size/borderless=true
window/size/transparent=true
window/size/always_on_top=true
window/size/resizable=false
window/per_pixel_transparency/allowed=true
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
textures/vram_compression/import_etc2_astc=true

[physics]

common/physics_ticks_per_second=30