# ─────────────────────────────────────────────────────────────────────────────
# JIMMY — variables d'environnement
# Copiez ce fichier en `.env` puis remplissez les valeurs.
# `.env` n'est JAMAIS commité (voir .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM : OpenCode Go (API compatible OpenAI) ───────────────────────────────
# Clé obtenue via le plan OpenCode Go (https://opencode.ai/docs/go).
# La requête DOIT aussi envoyer un header `x-opencode-session` (généré par Jimmy).
OPENCODE_API_KEY=
# Modèle par défaut. Modifiable depuis Paramètres > Modèle.
# Modèles gratuits known : space-bunny-free, longcat-2.5-preview-free
JIMMY_LLM_MODEL=space-bunny-free

# ── TTS : Fish Audio via OpenRouter ────────────────────────────────────────
OPENROUTER_API_KEY=
# Modèle TTS (version gratuite validée).
JIMMY_TTS_MODEL=fish-audio/s2.1-pro-free:free
# Voix Fish Audio de départ (la bibliothèque de la vue Voix en propose d'autres) :
#   4f2a0684dd0247dda68f339738c780e6 = « Le narrateur » (grave, posée — défaut)
#   5567200c7d8341738f0892bbacd3be3c = « Féminine » (calme, posée)
#   a288bdc744da4ad194921adad6863175 = « Clémence » (douce, claire)
JIMMY_TTS_VOICE=4f2a0684dd0247dda68f339738c780e6

# ── STT : whisper.cpp local ────────────────────────────────────────────────
# Chemin de l'exécutable `whisper-server.exe`. Vide = recherche automatique
# dans data/components/whisper/.
JIMMY_WHISPER_SERVER=
# Chemin du modèle ggml. Vide = recherche dans data/components/whisper/models/.
JIMMY_WHISPER_MODEL=
# Langue forcée pour la reconnaissance vocale.
JIMMY_STT_LANGUAGE=fr

# ── Vault Obsidian (mémoire persistante de Jimmy) ──────────────────────────
# Sans réglage, Jimmy prend le vault d'Obsidian de la machine, sinon il crée
# le sien (architecture PARA) dans son dossier de données. Cette variable
# impose un chemin, à chaque lancement.
# JIMMY_VAULT_PATH=C:\Users\user\Obsidian\MonVault

# ── Avatar Godot ───────────────────────────────────────────────────────────
# Port du serveur HTTP local expose par Godot (reçoit l'état de l'avatar).
JIMMY_GODOT_HOST=127.0.0.1
JIMMY_GODOT_PORT=8787
# Port du serveur HTTP local de Tauri (reçoit les événements de l'avatar).
JIMMY_BRIDGE_HOST=127.0.0.1
JIMMY_BRIDGE_PORT=8790
# Chemin de l'exécutable Godot. Vide = recherche automatique.
JIMMY_GODOT_EXE=

# ── Divers ─────────────────────────────────────────────────────────────────
# Niveau de journalisation : error | warn | info | debug | trace
JIMMY_LOG=info